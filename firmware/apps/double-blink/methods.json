{
  "app": "double-blink",
  "methods_version": 1,
  "description": "double-blink: Two quick flashes, then a longer pause. Settings: flash, gap and pause lengths.",
  "rf_stacks": {
    "versions": [
      "v1",
      "v2"
    ],
    "default": "v1",
    "description": "Radio stack versions this firmware supports. Chosen per profile; recorded, not yet sent to the node."
  },
  "methods": {
    "config.set": {
      "description": "Change settings. Only the keys given are changed; all apply immediately and persist across reboots. The 'led' settings depend on the app.",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "update_interval_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 600000,
            "description": "How often the payload (counter, temperature) is refreshed",
            "default": 5000
          },
          "adv_interval_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 10240,
            "description": "BLE advertising interval",
            "default": 1000
          },
          "led": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "LED on/off"
              },
              "flash_ms": {
                "type": "integer",
                "minimum": 20,
                "maximum": 500,
                "default": 80,
                "description": "Length of each of the two flashes"
              },
              "gap_ms": {
                "type": "integer",
                "minimum": 20,
                "maximum": 1000,
                "default": 120,
                "description": "Dark time between the two flashes"
              },
              "pause_ms": {
                "type": "integer",
                "minimum": 200,
                "maximum": 10000,
                "default": 1000,
                "description": "Dark time after the pair"
              }
            }
          }
        }
      }
    },
    "config.reset": {
      "description": "Restore all settings to their defaults.",
      "params": null
    },
    "device.identify": {
      "description": "Blink the LED fast so you can find the board.",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 300,
            "default": 10
          }
        }
      }
    },
    "device.reboot": {
      "description": "Reboot the node. A deploy reconnects before the next call.",
      "params": null,
      "reboots": true
    },
    "board.set_id": {
      "description": "Set this node's board ID (hs-<id>). Per-device: don't put this in shared configs.",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "default": 1
          }
        }
      },
      "per_device": true
    },
    "config.get": {
      "description": "Current settings.",
      "params": null
    },
    "device.info": {
      "description": "Device ID, BLE address, app, firmware, partition, board ID, family.",
      "params": null,
      "script": false
    },
    "device.status": {
      "description": "Uptime, heap, reset reason, temperature.",
      "params": null,
      "script": false
    },
    "ota.status": {
      "description": "OTA transfer state.",
      "params": null,
      "script": false
    },
    "rpc.discover": {
      "description": "List of methods.",
      "params": null,
      "script": false
    },
    "readings.read": {
      "description": "Buffered readings for the phone gateway (last hour), oldest first, paged.",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "boot_id": {
            "type": "number"
          },
          "after_uptime_s": {
            "type": "number",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      },
      "script": false
    }
  }
}
