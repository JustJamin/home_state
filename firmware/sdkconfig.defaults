CONFIG_IDF_TARGET="esp32c6"

# 4 MB flash (ESP32-C6FH4), two OTA slots, rollback
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# a hang that starves the idle task panics -> reboot -> rollback if still pending
CONFIG_ESP_TASK_WDT_PANIC=y

# USB serial is the console and carries JSON-RPC (rpc_usb.c)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Bluetooth: NimBLE host; broadcaster for readings, peripheral for OTA
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517

# The receiver (AR3012) is Bluetooth 4.0: legacy advertising only
CONFIG_BT_NIMBLE_EXT_ADV=n
